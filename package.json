{
  "name": "playwright_experience",
  "version": "1.0.0",
  "description": "Playwright API/UI test framework: JSONPlaceholder API + rabota.by UI",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint -c eslint.config.mjs '{ui,api}/**/*.{ts,json}' playwright.config.ts eslint.config.mjs",
    "lint:fix": "eslint -c eslint.config.mjs '{ui,api}/**/*.{ts,json}' playwright.config.ts eslint.config.mjs --fix",
    "typecheck": "tsc --noEmit",
    "html:report": "npx playwright show-report",
    "allure:report": "allure serve allure-results",
    "ui:mode": "npx playwright test --ui",
    "test:all": "rm -rf allure-results && npx playwright test",
    "test:api:no_oauth": "rm -rf allure-results && npx playwright test --project=noOAuth",
    "test:ui": "rm -rf allure-results && npx playwright test --project=ui",
    "test:smoke": "rm -rf allure-results && npx playwright test --grep @smoke"
  },
  "author": "Vyacheslav Pislyakov",
  "license": "ISC",
  "lint-staged": {
    "*.{ts,json}": "bash -c 'npm run typecheck'",
    "*.{ts,json,mjs}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "allure-commandline": "^2.38.0",
    "allure-playwright": "3.14.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-playwright": "^2.10.4",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^16.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
