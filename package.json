{
  "name": "playwright_experience",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "lint": "eslint -c eslint.config.mjs '{ui,api}/**/*.{ts,json}'",
    "lint:fix": "eslint -c eslint.config.mjs '{ui,api}/**/*.{ts,json}' --fix",
    "typecheck": "tsc --noEmit",
    "html:report": "npx playwright show-report",
    "allure:report": "allure serve allure-results",
    "ui:mode": "npx playwright test --ui",
    "test:all": "rm -rf allure-results && npx playwright test",
    "test:api:oauth": "rm -rf allure-results && npx playwright test --project=apiOAuth",
    "test:api:no_oauth": "rm -rf allure-results && npx playwright test --project=noOAuth",
    "test:ui": "rm -rf allure-results && npx playwright test --project=ui"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.60.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "allure-commandline": "^2.38.0",
    "allure-playwright": "^3.6.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^16.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "globals": "^16.5.0"
  }
}
