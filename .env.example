# Скопируйте в .env и заполните реальными значениями: cp .env.example .env
# Переменные читаются через optionalEnv/requireEnv из api/utils/envUtils.ts (load — initEnv в playwright.config.ts).

# ===API===
# Базовый URL публичного API для проекта noOAuth (используется в playwright.config.ts)
BASE_URL_NO_AUTH=https://jsonplaceholder.typicode.com

# Ключ для роли AUTHORIZED (getAuthHeaders -> header "x-rapidapi-key").
# Требуется только когда тесты создают клиент с UserRole.AUTHORIZED; для noOAuth/ui-прогонов не нужен.
API_KEY=

# ===UI===
# Базовый URL UI-проекта (используется в playwright.config.ts)
BASE_URL_UI=https://rabota.by/
